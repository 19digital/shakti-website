   "items": [
    {
     "k": "about.1",
     "t": "text",
     "v": "ABOUT SHAKTI",
     "sec": "about.top",
     "secLabel": "Page"
    },
    {
     "k": "about.2",
     "t": "text",
     "v": "Built in the Workshop, Proven on the Mill Floor",
     "sec": "about.top",
     "secLabel": "Page"
    },
    {
     "k": "about.3",
     "t": "text",
     "v": "Founded in Bardhaman, West Bengal, Shakti Engineering Works has spent over 20 years designing and fabricating the pre-milling machinery that modern rice mills across India, Bangladesh, Myanmar, Sri Lanka and South Africa run on every day.",
     "sec": "about.top",
     "secLabel": "Page"
    },
    {
     "k": "about.4",
     "t": "text",
     "v": "Our Story",
     "sec": "about.top",
     "secLabel": "Page"
    },
    {
     "k": "about.5",
     "t": "text",
     "v": "From a Small Fabrication Unit to a Pan-India Manufacturer",
     "sec": "about.top",
     "secLabel": "Page"
    },
    {
     "k": "about.6",
     "t": "text",
     "v": "What began as a small fabrication workshop serving local rice mills has grown into a full pre-milling machinery manufacturer — every elevator, dryer, parboiling plant and silo engineered, fabricated and quality-checked in-house.",
     "sec": "about.top",
     "secLabel": "Page"
    },
    {
     "k": "about.7",
     "t": "text",
     "v": "Today Shakti Engineering Works equips more than 500 mills, with installations pan-India and exports to Bangladesh, Myanmar, Sri Lanka and South Africa, backed by ISO 9001:2015 certified quality systems.",
     "sec": "about.top",
     "secLabel": "Page"
    },
    {
     "k": "about.8",
     "t": "img",
     "v": "images/factory-01.jpg",
