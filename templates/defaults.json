  "about": {
   "title": "About Us | Shakti Engineering Works — Rice Mill Machinery Manufacturer",
   "description": "20+ years designing and manufacturing rice mill pre-milling machinery in Bardhaman, West Bengal. ISO 9001:2015 certified, exporting across Asia and Africa.",
   "sections": [
